# Modèle du fichier .env (à copier en .env puis à remplir).
# Le vrai .env ne doit JAMAIS être versionné.

# Chaîne de connexion à la base PostgreSQL hébergée chez Neon
DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require
# Port d'écoute du serveur Express
PORT=3000
# Clé secrète qui signe les JWT. Générer une valeur longue et aléatoire avec :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# Durée de validité d'un badge (ex: 1h, 30m)
JWT_EXPIRES_IN=1h
# Seule origine autorisée par le CORS (le futur Front-end local)
FRONTEND_URL=http://localhost:3001
